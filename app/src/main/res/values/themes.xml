<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Qissat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Qissat.Player" parent="Theme.Qissat">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Qissat.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="Widget.Qissat.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Qissat.PlayerButton" parent="android:Widget.Material.ImageButton">
        <item name="android:background">@drawable/player_button_background</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Qissat.MenuItem" parent="android:Widget.Material.TextView">
        <item name="android:background">@drawable/menu_item_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
