<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/accent_dark" /><corners android:radius="26dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="26dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface_focused" /><corners android:radius="26dp" /></shape>
    </item>
</selector>
